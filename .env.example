# Django Settings
SECRET_KEY='your-secret-key-here-change-in-production'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/{{ project_name }}_db'

# Option 2: Use individual database settings
# DJANGO_DATABASE_NAME={{ project_name }}_db
# DJANGO_DATABASE_USER=postgres
# DJANGO_DATABASE_PASSWORD=postgres
# DJANGO_DATABASE_HOST=localhost
# DJANGO_DATABASE_PORT=5432

# Redis Configuration
REDIS_URL='redis://localhost:6379/0'
# OR
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
ACCOUNT_EMAIL_VERIFICATION=none

# JWT Configuration
SIMPLE_JWT_SIGNING_KEY='your-jwt-signing-key-change-in-production'

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Project Configuration
PROJECT_URL=http://localhost:8000
CONTACT_EMAIL=admin@example.com
TIME_ZONE=UTC

# Debug Toolbar (Development only)
ENABLE_DEBUG_TOOLBAR=False

# Logging
DJANGO_LOG_LEVEL=INFO
PROJECT_LOG_LEVEL=INFO

# AWS S3 Configuration (Optional)
USE_S3_MEDIA=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# Health Check
HEALTH_CHECK_TOKENS=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=

# Sentry (Optional)
SENTRY_DSN=

# Production Settings
USE_HTTPS_IN_ABSOLUTE_URLS=False
